NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=interviewer_companion

# Google authentication
GOOGLE_CLIENT_ID=
SESSION_SECRET=
FRONTEND_URL=http://localhost:5173

# Cookies: use COOKIE_SAMESITE=none when the frontend and API are on different sites (needs HTTPS)
COOKIE_SAMESITE=lax

# Image uploads: leave S3_BUCKET empty locally to store files in ./uploads (required on Lambda)
S3_BUCKET=
S3_KEY_PREFIX=uploads/
# Public base URL for the bucket, e.g. a CloudFront domain (no trailing slash)
S3_PUBLIC_BASE_URL=

# Lambda: pool size per instance (defaults to 2 on Lambda, 10 elsewhere)
# DB_CONNECTION_LIMIT=2
